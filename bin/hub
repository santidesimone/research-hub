#!/usr/bin/env node
// Command-line client for the research hub. No dependencies beyond Node 18+ (sync-notes uses gray-matter from web/node_modules).
//   hub config --url https://santidesimone.com/research-hub --token <HUB_API_TOKEN>     (saved to ~/.config/research-hub.json)
//   or set HUB_URL and HUB_API_TOKEN in the environment.
const fs = require('fs');
const os = require('os');
const path = require('path');

const CONFIG = path.join(os.homedir(), '.config', 'research-hub.json');
const read = (f) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return {}; } };
const cfg = { ...read(CONFIG) };
const url = (process.env.HUB_URL || cfg.url || 'http://127.0.0.1:3000').replace(/\/+$/, '').replace(/^(https?:\/\/)localhost(?=[:\/]|$)/, '$1127.0.0.1'); // Node resolves localhost to ::1 first; the server listens on 127.0.0.1
const token = process.env.HUB_API_TOKEN || cfg.token || '';

const HELP = `hub: research hub client   (${url})

  Query
    hub query "<cypher>" | -f file.cypher        read-only Cypher; add --json or --csv
    hub schema [collection]                       labels, relationships, conventions; or a collection's fields
    hub search <text>                             find papers
    hub get <key>                                 one artifact with its links

  Papers and files (files are links; nothing is stored in the database)
    hub add <doi | file.json | ->  [--file <url>] [--copy] [--status <s>]
                                                  add a paper (a DOI alone is looked up). --file stores a link;
                                                  --copy also downloads that PDF (arXiv/UCL) and uploads it to your Drive
    hub link <key> <url>                          set the file link (Drive share link, arXiv, publisher ...)
    hub unlink <key>                              remove the file link (a Drive file the hub uploaded is trashed)
    hub pdf <key> <file.pdf | https-url>          upload a PDF to your Google Drive and link it
    hub status <key> <value|none>                 set your personal status
    hub drive                                     check the Google Drive connection

  Collections (paper, report, method, use_case, case_study, ...)
    hub item list <collection> [--q text] [--sort f|-f] [--limit n] [--all] [--<filter> value]   e.g. --kind technique
    hub item get <key>                            every field, with who wrote it (you, Claude, source)
    hub item add <collection> [file.json | -]     create from {"title": ...} (a JSON object of fields)
    hub item edit <key> [file.json | -] [--set field=value ...]   only these fields change (and become yours)
    hub item rm <key> --yes                       delete
    hub item link <key> <rel> <target> [--evidence t] [--location p] [--confidence low|medium|high] [--result r (TESTS)]
    hub item unlink <key> <rel> <target>
    hub vocab iri <concept> <iri | none> [--ontology <key | none>]   point a concept at a term in an ontology (DEFINED_IN)
    hub ontology snapshot <key> <file | https-url | none>   a frozen copy in your Drive (owl, rdf, ttl, jsonld, xml, xsd,
                                                  json, csv, zip, txt, pdf); replaces the previous one. Check the license first
    hub oauth [list | revoke <id> | revoke-all]  MCP clients connected with OAuth (the claude.ai connector); revoke stops them at once

  Claude's analysis and the audit
    hub analyze <doi | url | key | file.pdf> [--deep] [--force] [--model m] [--collection c]  < analysis.json
                                                  save an analysis in one call: stdin is {fields, links, confidence};
                                                  a new report:/book:/method:/usecase:/case: key is created under that key;
                                                  a PDF needs the paper's doi or url in that JSON and is uploaded to Drive
    hub audit [--json]                            what is worth reviewing, with counts
    hub audit --accept-all-unchanged [--dry-run]  accept Claude's values that nobody changed (not low-confidence or ungrounded)

  Notes, citations, backup
    hub import-notes [dir=./content] [--dry-run]   turn Markdown notes (notes/*.md) into thoughts, once (projects are skipped)
    hub enrich                                    add citation edges from OpenAlex
    hub backup [file]                             save the whole graph to one JSON file
    hub restore <file>                            merge a backup back in (never deletes)
    hub export > library.json                     papers as CSL JSON
    hub sync                                      rebuild the public preview now

  hub config --url <base url> --token <token>     save connection settings
`;

const MAX_RETRIES = Number(process.env.HUB_MAX_RETRIES || 5);
async function call(method, p, body, extra = {}) {
  const headers = { Authorization: `Bearer ${token}`, ...(extra.headers || {}) };
  let payload = extra.raw;
  if (body !== undefined) { headers['Content-Type'] = 'application/json'; payload = JSON.stringify(body); }
  let res;
  // a 429 means slow down, not stop: wait as told (Retry-After, at most a minute) and try again, so a long
  // `hub restore` or `hub audit --accept-all-unchanged` survives the server's rate limits
  for (let attempt = 0; ; attempt++) {
    try { res = await fetch(url + p, { method, headers, body: payload }); }
    catch (e) { fail(`cannot reach ${url}: ${e.message}`); }
    if (res.status !== 429 || attempt >= MAX_RETRIES) break;
    const wait = Math.min(60, Math.max(1, Number(res.headers.get('retry-after')) || 5));
    console.error(`rate limited; retrying in ${wait}s`);
    await new Promise((r) => setTimeout(r, wait * 1000));
  }
  const textBody = await res.text();
  let data; try { data = JSON.parse(textBody); } catch { data = textBody; }
  if (res.status === 404 && extra.missing) return null; // the caller handles a missing item
  if (!res.ok) fail(`${res.status} ${(data && data.error) || textBody.slice(0, 200)}`);
  return data;
}
function fail(msg) { console.error('error: ' + msg); process.exit(1); }
const show = (v) => console.log(JSON.stringify(v, null, 2));

function cell(v) { return v == null ? '' : typeof v === 'object' ? JSON.stringify(v) : String(v); }
function table(columns, rows) {
  const w = columns.map((c) => Math.min(60, Math.max(c.length, ...rows.map((r) => cell(r[c]).length))));
  const line = (vals) => vals.map((v, i) => (v.length > w[i] ? v.slice(0, w[i] - 1) + '…' : v).padEnd(w[i])).join('  ');
  console.log(line(columns)); console.log(w.map((n) => '-'.repeat(n)).join('  '));
  for (const r of rows) console.log(line(columns.map((c) => cell(r[c]))));
}
function printResult(r, flags) {
  if (flags.json) return show(r);
  if (flags.csv) {
    const esc = (v) => { const s = cell(v); return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
    console.log(r.columns.join(',')); return r.rows.forEach((row) => console.log(r.columns.map((c) => esc(row[c])).join(',')));
  }
  table(r.columns, r.rows);
  console.error(`\n${r.count} row${r.count === 1 ? '' : 's'}${r.truncated ? ' (truncated to ' + r.rows.length + ')' : ''}`);
}

const BOOL_FLAGS = new Set(['json', 'csv', 'copy', 'dry-run', 'no-prune', 'help', 'all', 'yes', 'deep', 'force', 'accept-all-unchanged']);
function parse(argv) {
  const flags = {}, rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      if (BOOL_FLAGS.has(k)) flags[k] = true;
      else if (k === 'set') (flags.set = flags.set || []).push(argv[++i]); // repeatable: --set a=1 --set b=2
      else { const next = argv[i + 1]; if (next === undefined || next.startsWith('--')) flags[k] = true; else { flags[k] = next; i++; } }
    } else if (a === '-f') flags.f = argv[++i];
    else rest.push(a);
  }
  return { flags, rest };
}
const stdin = () => new Promise((r) => { let s = ''; process.stdin.on('data', (d) => (s += d)); process.stdin.on('end', () => r(s)); });
const enc = encodeURIComponent;

// A JSON object from a file, from '-', or from piped stdin; {} when nothing is piped.
async function readJson(src, what) {
  let text = '';
  if (src && src !== '-') { if (!fs.existsSync(src)) fail(`file not found: ${src}`); text = fs.readFileSync(src, 'utf8'); }
  else if (src === '-' || !process.stdin.isTTY) text = await stdin();
  if (!text.trim()) return {};
  try { const v = JSON.parse(text); if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error('expected a JSON object'); return v; }
  catch (e) { return fail(`${what}: ${e.message}`); }
}
// --set field=value: JSON when it parses (numbers, lists, objects, null), text otherwise
function parseSets(list) {
  const out = {};
  for (const s of list || []) {
    const i = String(s).indexOf('=');
    if (i < 1) fail(`--set needs field=value, got "${s}"`);
    const raw = s.slice(i + 1);
    try { out[s.slice(0, i)] = JSON.parse(raw); } catch { out[s.slice(0, i)] = raw; }
  }
  return out;
}
// list cells: links read as their names
const flat = (v) => (Array.isArray(v) ? v.map(flat).join(', ') : v && typeof v === 'object' && 'name' in v ? v.name : v);
const LIST_FLAGS = new Set(['q', 'sort', 'limit', 'cursor', 'all', 'json', 'csv']);
const KEY_COLLECTION = { 'method:': 'method', 'usecase:': 'use_case', 'case:': 'case_study', 'report:': 'report', 'book:': 'book' };

// What `hub analyze <thing>` was given -> { doi | url | key | pdf }
function identify(thing) {
  const t = String(thing).trim();
  const doi = t.replace(/^(doi:|https?:\/\/(dx\.)?doi\.org\/)/i, '');
  if (/^10\.\d+\/\S+$/.test(doi)) return { doi };
  if (/^https?:\/\//i.test(t)) return { url: t };
  if (/\.pdf$/i.test(t)) { if (!fs.existsSync(t)) fail(`file not found: ${t}`); return { pdf: t }; }
  if (/^[a-z_]+:\S+$/i.test(t)) return { key: t };
  return fail(`not a DOI, URL, key or PDF file: ${t}`);
}
async function itemCommand(sub, args, flags) {
  const usage = (u) => fail('usage: hub item ' + u);
  if (sub === 'list') {
    const c = args[0] || usage('list <collection> [--q text] [--sort f] [--limit n] [--all]');
    const qs = new URLSearchParams({ collection: c });
    for (const [k, v] of Object.entries(flags)) if (!LIST_FLAGS.has(k) && v !== true) qs.set(k, v); // schema filters
    for (const k of ['q', 'sort', 'limit', 'cursor']) if (flags[k] && flags[k] !== true) qs.set(k, flags[k]);
    const rows = [];
    let r;
    do { r = await call('GET', '/api/items?' + qs); rows.push(...r.items); if (r.next_cursor) qs.set('cursor', r.next_cursor); } while (flags.all && r.next_cursor);
    if (flags.json) return show({ ...r, items: rows });
    const columns = [...new Set(['key', 'title', ...rows.flatMap((x) => Object.keys(x)).filter((k) => !['updated_at'].includes(k))])];
    const flatRows = rows.map((x) => Object.fromEntries(columns.map((k) => [k, flat(x[k])])));
    printResult({ columns, rows: flatRows, count: rows.length, truncated: false }, flags);
    if (!flags.all && r.next_cursor) console.error(`${r.total} in all; --all for every page`);
    return;
  }
  if (sub === 'get') {
    const it = await call('GET', '/api/items/' + enc(args[0] || usage('get <key>')));
    if (flags.json) return show(it);
    console.log(`${it.key}  (${it.collection}, ${it.record_status || 'no status'})`);
    for (const [f, v] of Object.entries(it.fields)) {
      if (v == null || (Array.isArray(v) && !v.length)) continue;
      const p = it.provenance[f];
      const who = p ? ` [${[p.by === 'owner' ? 'you' : p.by, p.model, p.confidence, p.status === 'reviewed' && p.by !== 'owner' ? 'reviewed' : null].filter(Boolean).join(', ')}]` : '';
      console.log(`  ${f}: ${typeof v === 'object' && !Array.isArray(v) && !('name' in v) ? JSON.stringify(v) : Array.isArray(v) && v.some((x) => x && typeof x === 'object' && !('name' in x)) ? JSON.stringify(v) : flat(v)}${who}`);
    }
    for (const l of it.links.out.filter((x) => !x.field)) console.log(`  -> ${l.rel} ${l.key}${l.evidence ? `  "${l.evidence}"` : ''}`);
    for (const l of it.links.in) console.log(`  <- ${l.rel} ${l.key}`);
    return;
  }
  if (sub === 'add') {
    const c = args[0] || usage('add <collection> [file.json | -]');
    const fields = { ...(await readJson(args[1], 'fields')), ...parseSets(flags.set) };
    return show(await call('POST', '/api/items', { collection: c, fields, ...(flags.slug ? { slug: flags.slug } : {}) }));
  }
  if (sub === 'edit') {
    const key = args[0] || usage('edit <key> [file.json | -] [--set field=value ...]');
    const fields = { ...(flags.set && !args[1] ? {} : await readJson(args[1], 'fields')), ...parseSets(flags.set) };
    if (!Object.keys(fields).length) fail('nothing to change: pass a JSON file, - for stdin, or --set field=value');
    return show(await call('PATCH', '/api/items/' + enc(key), { fields }));
  }
  if (sub === 'rm') {
    const key = args[0] || usage('rm <key> --yes');
    if (!flags.yes) fail(`this deletes ${key} for good; add --yes to confirm`);
    return show(await call('DELETE', '/api/items/' + enc(key)));
  }
  if (sub === 'link' || sub === 'unlink') {
    const [key, rel, target] = args;
    if (!key || !rel || !target) usage(`${sub} <key> <rel> <target>`);
    if (sub === 'unlink') return show(await call('DELETE', `/api/items/${enc(key)}/links?rel=${enc(rel)}&target=${enc(target)}`));
    const body = { rel, target };
    for (const k of ['evidence', 'location', 'confidence', 'result']) if (flags[k] && flags[k] !== true) body[k] = flags[k];
    return show(await call('PUT', `/api/items/${enc(key)}/links`, body));
  }
  return usage('list | get | add | edit | rm | link | unlink');
}
async function analyzeCommand(args, flags) {
  const id = identify(args[0] || fail('usage: hub analyze <doi | url | key | file.pdf> < analysis.json'));
  const input = await readJson(args[1], 'analysis JSON');
  const model = (flags.model !== true && flags.model) || input.model || process.env.HUB_MODEL || fail('which model did the analysis? pass --model, "model" in the JSON, or set HUB_MODEL');
  const body = { collection: flags.collection || input.collection || (id.key && Object.entries(KEY_COLLECTION).find(([p]) => id.key.startsWith(p))?.[1]) || 'paper',
    model, fields: input.fields || {}, links: input.links || [] };
  if (input.confidence) body.confidence = input.confidence;
  if (flags.deep) body.tier = 'deep';
  if (flags.force) body.force = true;
  if (id.pdf) {
    if (!input.doi && !input.url && !input.key) fail('a PDF needs the paper\'s "doi" or "url" (or "key") in the analysis JSON');
    Object.assign(body, input.doi ? { doi: input.doi } : input.url ? { url: input.url } : { key: input.key });
  } else Object.assign(body, id);
  // a report:, method:, ... key that does not exist yet is created under that key, so running it again updates it
  const keyed = id.key && Object.keys(KEY_COLLECTION).some((p) => id.key.startsWith(p));
  let out = await call('POST', '/api/analysis', body, { missing: keyed });
  if (!out) { const { key, ...rest } = body; out = await call('POST', '/api/analysis', { ...rest, slug: key.slice(key.indexOf(':') + 1) }); }
  if (id.pdf) {
    try { out.file = await call('POST', '/api/papers/file?key=' + enc(out.key), undefined, { raw: fs.readFileSync(id.pdf), headers: { 'Content-Type': 'application/pdf' } }); }
    catch (e) { out.file_error = e.message; }
  }
  return show(out);
}
// Claude values nobody changed: still by=claude and auto, minus low-confidence values and ungrounded findings.
function unchangedFields(item) {
  const ungrounded = (item.fields.key_findings || []).some((k) => !k || typeof k !== 'object' || !String(k.location || '').trim());
  const accept = [];
  const skip = [];
  for (const [f, p] of Object.entries(item.provenance || {})) {
    if (!p || p.by !== 'claude' || p.status !== 'auto') continue;
    if (p.confidence === 'low') skip.push(`${f} (low confidence)`);
    else if (f === 'key_findings' && ungrounded) skip.push(`${f} (ungrounded)`);
    else accept.push(f);
  }
  return { accept, skip };
}
async function auditCommand(flags) {
  const r = await call('GET', '/api/audit?limit=1000');
  if (flags['accept-all-unchanged']) {
    const report = { accepted: {}, skipped: {}, dry_run: Boolean(flags['dry-run']) };
    for (const { key } of r.unreviewed_items) {
      const { accept, skip } = unchangedFields(await call('GET', '/api/items/' + enc(key)));
      if (accept.length) { if (!flags['dry-run']) await call('POST', '/api/audit/accept', { key, fields: accept }); report.accepted[key] = accept; }
      if (skip.length) report.skipped[key] = skip;
    }
    return show(report);
  }
  if (flags.json) return show(r);
  const name = (x) => x.title || x.name || x.key;
  for (const [k, n] of Object.entries(r.counts)) {
    console.log(`${k.replace(/_/g, ' ')}: ${n}`);
    for (const x of (r[k] || []).slice(0, 5)) console.log(`  ${x.key}  ${name(x)}${x.field ? '  ' + x.field : ''}${x.rel ? '  ' + x.rel + ' -> ' + x.target : ''}`);
    if (n > 5) console.log('  ...');
  }
}
async function schemaCommand(c, flags) {
  if (!c) return show(await call('GET', '/api/query/schema'));
  const s = await call('GET', '/api/schema');
  const coll = s.collections.find((x) => x.name === c || x.slug === c) || fail(`no collection "${c}" (${s.collections.map((x) => x.name).join(', ')})`);
  if (flags.json) return show(coll);
  const rows = Object.entries(coll.fields).map(([f, x]) => ({ field: f, type: x.type + (x.list ? '[]' : ''), tier: x.tier, by: x.by.join(''), values: x.enum ? x.enum.join('|') : x.ref || (x.props ? Object.keys(x.props).join(',') : '') }));
  table(['field', 'type', 'tier', 'by', 'values'], rows);
  console.error(`\nby: S source, C Claude, Y you. Filters: ${coll.filters.join(', ')}. Locked for edits: ${(coll.locked || []).join(', ') || 'none'}`);
}

// Markdown files -> [{ path, meta, body }] (the hub turns them into nodes; see web/core/notes.js).
function readNotes(dir) {
  let matter;
  try { matter = require(require.resolve('gray-matter', { paths: [path.join(__dirname, '..', 'web')] })); }
  catch { fail('gray-matter is missing: run `npm install` in the web/ folder first'); }
  if (!fs.existsSync(dir)) fail(`folder not found: ${dir}`);
  const out = [];
  const walk = (d) => {
    for (const e of fs.readdirSync(d, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      const full = path.join(d, e.name);
      if (e.isDirectory()) { if (!e.name.startsWith('.') && e.name !== 'node_modules') walk(full); }
      else if (/\.md$/i.test(e.name)) {
        try {
          const post = matter(fs.readFileSync(full, 'utf8'));
          out.push({ path: path.relative(dir, full).split(path.sep).join('/'), meta: post.data, body: post.content });
        } catch (err) { console.error(`skip ${full}: ${err.message}`); }
      }
    }
  };
  walk(path.resolve(dir));
  return out;
}

(async () => {
  const { flags, rest } = parse(process.argv.slice(2));
  const [cmd, ...args] = rest;
  if (!cmd || cmd === 'help' || flags.help) return console.log(HELP);
  if (cmd === 'config') {
    if (!flags.url && !flags.token) fail('pass --url and/or --token');
    fs.mkdirSync(path.dirname(CONFIG), { recursive: true });
    fs.writeFileSync(CONFIG, JSON.stringify({ ...cfg, ...(flags.url ? { url: flags.url } : {}), ...(flags.token ? { token: flags.token } : {}) }, null, 2), { mode: 0o600 });
    return console.log('saved ' + CONFIG);
  }
  if (!token) fail('no token: run `hub config --token ...` or set HUB_API_TOKEN');

  if (cmd === 'query') {
    const cypher = flags.f ? fs.readFileSync(flags.f, 'utf8') : args.join(' ') || (await stdin());
    return printResult(await call('POST', '/api/query', { cypher }), flags);
  }
  if (cmd === 'schema') return schemaCommand(args[0], flags);
  if (cmd === 'item') return itemCommand(args[0], args.slice(1), flags);
  if (cmd === 'analyze') return analyzeCommand(args, flags);
  if (cmd === 'audit') return auditCommand(flags);
  if (cmd === 'oauth') {
    const [op = 'list', id] = args;
    if (op === 'list') return show(await call('GET', '/api/oauth/grants'));
    if (op === 'revoke' && id) return show(await call('DELETE', '/api/oauth/grants?id=' + enc(id)));
    if (op === 'revoke-all') return show(await call('DELETE', '/api/oauth/grants?all=1'));
    fail('usage: hub oauth [list | revoke <id> | revoke-all]');
  }
  if (cmd === 'ontology') {
    const [sub, key, src] = args;
    if (sub !== 'snapshot' || !key || !src) fail('usage: hub ontology snapshot <ontology key> <file | https-url | none>');
    if (src === 'none') return show(await call('DELETE', '/api/ontologies/snapshot?key=' + enc(key)));
    if (/^https:\/\//i.test(src)) return show(await call('POST', '/api/ontologies/snapshot?key=' + enc(key), { url: src }));
    if (!fs.existsSync(src)) fail(`file not found: ${src}`);
    return show(await call('POST', `/api/ontologies/snapshot?key=${enc(key)}&name=${enc(path.basename(src))}`, undefined,
      { raw: fs.readFileSync(src), headers: { 'Content-Type': 'application/octet-stream' } }));
  }
  if (cmd === 'vocab') {
    const [sub, concept, iri] = args;
    if (sub !== 'iri' || !concept || !iri) fail('usage: hub vocab iri <concept key> <iri | none> [--ontology <key | none>]');
    const body = { external_iri: iri === 'none' ? null : iri };
    if (flags.ontology && flags.ontology !== true) body.defined_in = flags.ontology === 'none' ? null : flags.ontology;
    return show(await call('PATCH', '/api/vocab?key=' + enc(concept), body));
  }
  if (cmd === 'search') {
    const r = await call('POST', '/api/query', { cypher: "MATCH (p:Paper) WHERE toLower(p.title + ' ' + coalesce(p.venue,'') + ' ' + reduce(s='', a IN p.authors | s + ' ' + a)) CONTAINS $q RETURN p.key AS key, p.year AS year, p.title AS title ORDER BY year DESC LIMIT 50", params: { q: args.join(' ').toLowerCase() } });
    return printResult(r, flags);
  }
  if (cmd === 'get') return show(await call('GET', '/api/artifact?key=' + enc(args[0] || fail('usage: hub get <key>'))));
  if (cmd === 'add') {
    const src = args[0] || fail('usage: hub add <doi | file.json | ->');
    let item;
    if (src === '-') item = JSON.parse(await stdin());
    else if (fs.existsSync(src)) item = JSON.parse(fs.readFileSync(src, 'utf8'));
    else item = { DOI: src };
    const file = flags.file || flags.pdf; // --pdf is the older name
    if (file && file !== true) item.file_url = file;
    if (flags.copy) item.copy_to_drive = true;
    if (flags.status) item.tags = [...(item.tags || []), 'status:' + flags.status];
    return show(await call('POST', '/api/papers', item));
  }
  if (cmd === 'link') {
    const [key, u] = args; if (!key || !u) fail('usage: hub link <key> <url>');
    return show(await call('PUT', '/api/papers/file?key=' + enc(key), { file_url: u }));
  }
  if (cmd === 'unlink') return show(await call('DELETE', '/api/papers/file?key=' + enc(args[0] || fail('usage: hub unlink <key>'))));
  if (cmd === 'pdf') {
    const [key, src] = args; if (!key || !src) fail('usage: hub pdf <key> <file.pdf | https-url>');
    if (/^https:\/\//.test(src)) return show(await call('POST', '/api/papers/file?key=' + enc(key), { pdf_url: src }));
    return show(await call('POST', '/api/papers/file?key=' + enc(key), undefined, { raw: fs.readFileSync(src), headers: { 'Content-Type': 'application/pdf' } }));
  }
  if (cmd === 'drive') return show(await call('POST', '/api/drive/check'));
  if (cmd === 'status') {
    const [key, value] = args; if (!key || value === undefined) fail('usage: hub status <key> <value|none>');
    return show(await call('PUT', '/api/personal?key=' + enc(key), { status: value === 'none' ? null : value }));
  }
  if (cmd === 'sync-notes') fail('sync-notes is retired: notes are thoughts in the hub now. Run `hub import-notes <dir>` once to bring Markdown notes in as thoughts.');
  // Markdown notes -> thoughts (state kept), with their links to papers and items. Projects are no longer part of the
  // hub and are skipped. A note imported before is left alone (its thought key is taken), so running it twice is safe.
  if (cmd === 'import-notes') {
    const dir = args[0] || 'content';
    const notes = readNotes(dir).filter((n) => /(^|\/)notes\//.test(n.path) || (n.meta && n.meta.kind === 'note'));
    const LINKS = { annotates: 'ANNOTATES', critiques: 'CRITIQUES', supports: 'SUPPORTS', contradicts: 'CONTRADICTS' };
    const out = { imported: [], skipped: [], links: 0, link_errors: [] };
    for (const n of notes) {
      const name = n.path.replace(/^.*\//, '').replace(/\.md$/, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const text = [n.meta.title, n.meta.summary, (n.body || '').trim()].filter(Boolean).join('\n\n');
      if (!text) { out.skipped.push({ path: n.path, reason: 'empty' }); continue; }
      if (flags['dry-run']) { out.imported.push({ path: n.path, key: 'thought:note-' + name }); continue; }
      let key;
      try {
        key = (await call('POST', '/api/items', { collection: 'thought', slug: 'note-' + name, fields: { text, title: String(n.meta.title || text).slice(0, 200), state: 'kept', visibility: n.meta.visibility === 'public' ? 'public' : 'private' } })).key;
      } catch (e) { out.skipped.push({ path: n.path, reason: e.message }); continue; }
      out.imported.push({ path: n.path, key });
      for (const [field, rel] of Object.entries(LINKS)) {
        for (const target of [].concat(n.meta[field] || [])) {
          try { await call('PUT', `/api/items/${enc(key)}/links`, { rel, target: String(target).toLowerCase().startsWith('doi:') ? 'doi:' + String(target).slice(4).toLowerCase() : target, evidence: rel === 'ANNOTATES' ? undefined : (n.meta.summary || text).slice(0, 2000) }); out.links += 1; } catch (e) { out.link_errors.push({ path: n.path, target, reason: e.message }); }
        }
      }
    }
    console.error(`${notes.length} note${notes.length === 1 ? '' : 's'} in ${dir}`);
    return show(out);
  }
  if (cmd === 'enrich') {
    let offset = 0, total = { processed: 0, matched: 0, cites_edges: 0, errors: [] };
    for (;;) {
      const r = await call('POST', `/api/enrich?limit=50&offset=${offset}`);
      total.processed += r.processed; total.matched += r.matched; total.cites_edges += r.cites_edges; total.errors.push(...r.errors);
      console.error(`processed ${total.processed}`);
      if (r.next_offset == null) break;
      offset = r.next_offset;
    }
    return show(total);
  }
  if (cmd === 'backup') {
    const data = await call('GET', '/api/backup');
    const file = args[0] || `research-hub-backup-${new Date().toISOString().slice(0, 10)}.json`;
    fs.writeFileSync(file, JSON.stringify(data), { mode: 0o600 });
    return console.log(`saved ${file}: ${data.nodes.length} nodes, ${data.rels.length} relationships`);
  }
  if (cmd === 'restore') {
    const file = args[0] || fail('usage: hub restore <backup.json>');
    const doc = JSON.parse(fs.readFileSync(file, 'utf8'));
    const total = { nodes: 0, rels_restored: 0, rels_skipped: 0 };
    const send = async (part) => { const r = await call('POST', '/api/restore', { format: doc.format, version: doc.version, ...part }); total.nodes += r.nodes; total.rels_restored += r.rels_restored; total.rels_skipped += r.rels_skipped; };
    const STEP = 2000; // keeps each request well under Cloud Run's 32 MB limit
    for (let i = 0; i < doc.nodes.length; i += STEP) await send({ nodes: doc.nodes.slice(i, i + STEP) });
    for (let i = 0; i < doc.rels.length; i += STEP) await send({ rels: doc.rels.slice(i, i + STEP) });
    return show(total);
  }
  if (cmd === 'export') return show(await call('GET', '/api/export'));
  if (cmd === 'sync') return show(await call('POST', '/api/sync'));
  fail(`unknown command "${cmd}" (try: hub help)`);
})();
