{
  "version": 4,
  "description": "Single source of truth for the graph model (spec: docs/SCHEMA_DESIGN.md, history: schema/CHANGELOG.md). Read by the web app: API validation, UI, MCP, migrations, public preview, backup. Types with \"collection\": true are the Library collections; their fields are common_fields plus their own \"fields\". Types may set label_plural (UI). Field keys: type (text, longtext, markdown, integer, date, datetime, url, boolean, enum, object, ref), enum, list, ref (an entity or type label), rel, by (S source, C Claude, Y owner, Sys hub), tier (core, standard, deep), required, default, label, help, min, max, props (for objects).",
  "field_types": ["text", "longtext", "markdown", "integer", "date", "datetime", "url", "boolean", "enum", "object", "ref"],
  "common_fields": {
    "key": { "type": "text", "by": ["Sys"], "tier": "core", "label": "Key" },
    "collection": { "type": "enum", "enum": ["paper", "report", "method", "use_case", "case_study", "framework", "research_question", "hypothesis", "ontology", "thought"], "by": ["Sys"], "tier": "core", "label": "Collection" },
    "title": { "type": "text", "by": ["S", "C", "Y"], "tier": "core", "required": true, "label": "Title" },
    "tldr": { "type": "text", "by": ["C"], "tier": "core", "label": "TL;DR", "help": "One sentence." },
    "summary": { "type": "longtext", "by": ["C"], "tier": "standard", "label": "Summary" },
    "body": { "type": "markdown", "by": ["Y"], "tier": "standard", "label": "Notes", "help": "Your own long notes, in Markdown." },
    "topics": { "type": "ref", "ref": "Topic", "rel": "ABOUT", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Topics" },
    "tags": { "type": "text", "list": true, "by": ["Y"], "tier": "standard", "label": "Tags" },
    "visibility": { "type": "enum", "enum": ["private", "public"], "default": "private", "by": ["Y"], "tier": "core", "label": "Visibility" },
    "record_status": { "type": "enum", "enum": ["auto", "reviewed"], "default": "auto", "by": ["Sys", "Y"], "tier": "core", "label": "Record status" },
    "schema_version": { "type": "integer", "by": ["Sys"], "tier": "core", "label": "Schema version" },
    "provenance": { "type": "object", "by": ["Sys"], "tier": "core", "label": "Provenance", "help": "field -> {by, at, model, confidence, status}" },
    "created_at": { "type": "datetime", "by": ["Sys"], "tier": "core", "label": "Created" },
    "updated_at": { "type": "datetime", "by": ["Sys"], "tier": "core", "label": "Updated" }
  },
  "ui_sections": [
    { "id": "capture", "label": "" },
    { "id": "reading", "label": "Reading" },
    { "id": "knowledge", "label": "Knowledge" },
    { "id": "inquiry", "label": "Inquiry" }
  ],
  "types": {
    "paper": {
      "label": "Paper",
      "label_plural": "Papers",
      "color": "#6366f1",
      "big": true,
      "folder": null,
      "collection": true,
      "ui_section": "reading",
      "managed": "api",
      "schema_version": 2,
      "props": [],
      "fields": {
        "authors": { "type": "ref", "ref": "Person", "rel": "AUTHORED_BY", "list": true, "by": ["S"], "tier": "core", "label": "Authors", "help": "Ordered." },
        "year": { "type": "integer", "by": ["S"], "tier": "core", "label": "Year" },
        "date": { "type": "date", "by": ["S"], "tier": "core", "label": "Date" },
        "venue": { "type": "ref", "ref": "Venue", "rel": "PUBLISHED_IN", "by": ["S"], "tier": "core", "label": "Venue" },
        "item_type": { "type": "enum", "enum": ["journal_article", "conference_paper", "preprint", "thesis", "report", "book_chapter", "standard", "talk"], "by": ["S"], "tier": "core", "label": "Item type" },
        "doi": { "type": "text", "by": ["S"], "tier": "core", "label": "DOI" },
        "arxiv_id": { "type": "text", "by": ["S"], "tier": "core", "label": "arXiv id" },
        "url": { "type": "url", "by": ["S"], "tier": "core", "label": "URL" },
        "abstract": { "type": "longtext", "by": ["S"], "tier": "standard", "label": "Abstract" },
        "peer_review": { "type": "enum", "enum": ["peer_reviewed", "preprint", "grey"], "by": ["S", "C"], "tier": "standard", "label": "Peer review" },
        "open_access": { "type": "enum", "enum": ["gold", "green", "closed"], "by": ["S"], "tier": "deep", "label": "Open access" },
        "citation_count": { "type": "integer", "min": 0, "by": ["S"], "tier": "deep", "label": "Citations" },
        "citation_count_at": { "type": "date", "by": ["S"], "tier": "deep", "label": "Citations as of" },
        "language": { "type": "text", "by": ["S"], "tier": "deep", "label": "Language" },
        "contribution_type": { "type": "enum", "enum": ["theoretical", "empirical", "methodological", "system", "survey", "position", "dataset", "replication"], "by": ["C"], "tier": "core", "label": "Contribution" },
        "research_design": { "type": "enum", "enum": ["experiment", "quasi_experiment", "observational", "survey", "simulation", "formal_proof", "qualitative", "case_study", "design_science", "mixed_methods", "desk_review"], "by": ["C"], "tier": "standard", "label": "Research design" },
        "paradigm": { "type": "enum", "enum": ["quantitative", "qualitative", "mixed", "formal"], "by": ["C"], "tier": "standard", "label": "Paradigm" },
        "domain": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "by": ["C"], "tier": "standard", "label": "Domain" },
        "theoretical_framework": { "type": "longtext", "by": ["C"], "tier": "deep", "label": "Theoretical framework" },
        "research_problem": { "type": "longtext", "by": ["C"], "tier": "core", "label": "Research problem" },
        "stated_question": { "type": "longtext", "by": ["C", "Y"], "tier": "standard", "label": "Its own research question", "help": "The question the paper itself sets out to answer, in its words. Your own research questions are separate items that this paper can inform." },
        "main_claim": { "type": "longtext", "by": ["C"], "tier": "core", "label": "Main claim" },
        "contributions": { "type": "object", "list": true, "props": { "text": "text", "kind": "text" }, "by": ["C"], "tier": "standard", "label": "Contributions", "help": "kind: novel, extension or application." },
        "approach": { "type": "longtext", "by": ["C"], "tier": "standard", "label": "Approach" },
        "evidence": { "type": "object", "props": { "type": "text", "source": "text", "n": "integer", "period": "text" }, "by": ["C"], "tier": "standard", "label": "Evidence" },
        "analysis_methods": { "type": "ref", "ref": "Method", "rel": "USES", "list": true, "by": ["C"], "tier": "standard", "label": "Analysis methods" },
        "key_findings": { "type": "object", "list": true, "props": { "text": "text", "location": "text" }, "by": ["C"], "tier": "standard", "label": "Key findings", "help": "Each finding needs a location (page or section)." },
        "limitations_stated": { "type": "text", "list": true, "by": ["C"], "tier": "standard", "label": "Stated limitations" },
        "limitations_observed": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "deep", "label": "Observed limitations" },
        "assumptions": { "type": "text", "list": true, "by": ["C"], "tier": "deep", "label": "Assumptions" },
        "threats_to_validity": { "type": "object", "props": { "internal": "text", "external": "text", "construct": "text", "conclusion": "text" }, "by": ["C"], "tier": "deep", "label": "Threats to validity" },
        "reproducibility": { "type": "object", "props": { "code_available": "boolean", "data_available": "boolean", "links": "text" }, "by": ["C"], "tier": "deep", "label": "Reproducibility" },
        "implications": { "type": "object", "props": { "theory": "text", "practice": "text" }, "by": ["C"], "tier": "deep", "label": "Implications" },
        "future_work": { "type": "text", "list": true, "by": ["C"], "tier": "deep", "label": "Future work" },
        "conflicts_funding": { "type": "longtext", "by": ["C"], "tier": "deep", "label": "Conflicts and funding" },
        "relevance": { "type": "integer", "min": 1, "max": 5, "by": ["Y"], "tier": "standard", "label": "Relevance" },
        "relevance_reason": { "type": "text", "by": ["Y"], "tier": "standard", "label": "Why relevant" },
        "reading_depth": { "type": "enum", "enum": ["skimmed", "read", "studied"], "by": ["Y"], "tier": "standard", "label": "Reading depth" },
        "rigor": { "type": "integer", "min": 1, "max": 5, "by": ["Y", "C"], "tier": "deep", "label": "Rigour" },
        "rigor_reason": { "type": "text", "by": ["Y", "C"], "tier": "deep", "label": "Rigour reason" },
        "novelty": { "type": "integer", "min": 1, "max": 5, "by": ["Y", "C"], "tier": "deep", "label": "Novelty" },
        "novelty_reason": { "type": "text", "by": ["Y", "C"], "tier": "deep", "label": "Novelty reason" },
        "confidence_in_findings": { "type": "enum", "enum": ["low", "medium", "high"], "by": ["Y"], "tier": "deep", "label": "Confidence in findings" }
      },
      "list_columns": ["title", "authors", "year", "contribution_type", "relevance"],
      "filters": ["item_type", "contribution_type", "research_design", "domain", "topics", "reading_depth"],
      "detail_groups": [
        { "label": "Bibliographic", "fields": ["authors", "year", "date", "venue", "item_type", "doi", "arxiv_id", "url", "abstract", "peer_review", "open_access", "citation_count", "citation_count_at", "language"] },
        { "label": "Classification", "fields": ["contribution_type", "research_design", "paradigm", "domain", "theoretical_framework"] },
        { "label": "Content", "fields": ["research_problem", "stated_question", "main_claim", "contributions", "approach", "evidence", "analysis_methods", "key_findings", "limitations_stated", "limitations_observed", "assumptions", "threats_to_validity", "reproducibility", "implications", "future_work", "conflicts_funding"] },
        { "label": "Appraisal", "fields": ["relevance", "relevance_reason", "reading_depth", "rigor", "rigor_reason", "novelty", "novelty_reason", "confidence_in_findings"] }
      ]
    },
    "report": {
      "label": "Report",
      "label_plural": "Reports",
      "color": "#6b5b4f",
