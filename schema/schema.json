{
  "version": 3,
  "description": "Single source of truth for the graph model (spec: docs/SCHEMA_DESIGN.md, history: schema/CHANGELOG.md). Read by the web app: API validation, UI, MCP, migrations, public preview, backup. Types with \"collection\": true are the Library collections; their fields are common_fields plus their own \"fields\". Types may set label_plural (UI). Field keys: type (text, longtext, markdown, integer, date, datetime, url, boolean, enum, object, ref), enum, list, ref (an entity or type label), rel, by (S source, C Claude, Y owner, Sys hub), tier (core, standard, deep), required, default, label, help, min, max, props (for objects).",
  "field_types": ["text", "longtext", "markdown", "integer", "date", "datetime", "url", "boolean", "enum", "object", "ref"],
  "common_fields": {
    "key": { "type": "text", "by": ["Sys"], "tier": "core", "label": "Key" },
    "collection": { "type": "enum", "enum": ["paper", "method", "use_case", "case_study"], "by": ["Sys"], "tier": "core", "label": "Collection" },
    "title": { "type": "text", "by": ["S", "C", "Y"], "tier": "core", "required": true, "label": "Title" },
    "tldr": { "type": "text", "by": ["C"], "tier": "core", "label": "TL;DR", "help": "One sentence." },
    "summary": { "type": "longtext", "by": ["C"], "tier": "standard", "label": "Summary" },
    "body": { "type": "markdown", "by": ["Y"], "tier": "standard", "label": "Notes", "help": "Your own long notes, in Markdown." },
    "topics": { "type": "ref", "ref": "Topic", "rel": "ABOUT", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Topics" },
    "tags": { "type": "text", "list": true, "by": ["Y"], "tier": "standard", "label": "Tags" },
    "visibility": { "type": "enum", "enum": ["private", "public"], "default": "private", "by": ["Y"], "tier": "core", "label": "Visibility" },
    "record_status": { "type": "enum", "enum": ["auto", "reviewed"], "default": "auto", "by": ["Sys", "Y"], "tier": "core", "label": "Record status" },
    "schema_version": { "type": "integer", "by": ["Sys"], "tier": "core", "label": "Schema version" },
    "provenance": { "type": "object", "by": ["Sys"], "tier": "core", "label": "Provenance", "help": "field -> {by, at, model, confidence, status}" },
    "created_at": { "type": "datetime", "by": ["Sys"], "tier": "core", "label": "Created" },
    "updated_at": { "type": "datetime", "by": ["Sys"], "tier": "core", "label": "Updated" }
  },
  "types": {
    "paper": {
      "label": "Paper",
      "label_plural": "Papers",
      "color": "#6366f1",
      "big": true,
      "folder": null,
      "collection": true,
      "managed": "api",
      "schema_version": 1,
      "props": [],
      "fields": {
        "authors": { "type": "ref", "ref": "Person", "rel": "AUTHORED_BY", "list": true, "by": ["S"], "tier": "core", "label": "Authors", "help": "Ordered." },
        "year": { "type": "integer", "by": ["S"], "tier": "core", "label": "Year" },
        "date": { "type": "date", "by": ["S"], "tier": "core", "label": "Date" },
        "venue": { "type": "ref", "ref": "Venue", "rel": "PUBLISHED_IN", "by": ["S"], "tier": "core", "label": "Venue" },
        "item_type": { "type": "enum", "enum": ["journal_article", "conference_paper", "preprint", "thesis", "report", "book_chapter", "standard", "talk"], "by": ["S"], "tier": "core", "label": "Item type" },
        "doi": { "type": "text", "by": ["S"], "tier": "core", "label": "DOI" },
        "arxiv_id": { "type": "text", "by": ["S"], "tier": "core", "label": "arXiv id" },
        "url": { "type": "url", "by": ["S"], "tier": "core", "label": "URL" },
        "abstract": { "type": "longtext", "by": ["S"], "tier": "standard", "label": "Abstract" },
        "peer_review": { "type": "enum", "enum": ["peer_reviewed", "preprint", "grey"], "by": ["S", "C"], "tier": "standard", "label": "Peer review" },
        "open_access": { "type": "enum", "enum": ["gold", "green", "closed"], "by": ["S"], "tier": "deep", "label": "Open access" },
        "citation_count": { "type": "integer", "min": 0, "by": ["S"], "tier": "deep", "label": "Citations" },
        "citation_count_at": { "type": "date", "by": ["S"], "tier": "deep", "label": "Citations as of" },
        "language": { "type": "text", "by": ["S"], "tier": "deep", "label": "Language" },
        "contribution_type": { "type": "enum", "enum": ["theoretical", "empirical", "methodological", "system", "survey", "position", "dataset", "replication"], "by": ["C"], "tier": "core", "label": "Contribution" },
        "research_design": { "type": "enum", "enum": ["experiment", "quasi_experiment", "observational", "survey", "simulation", "formal_proof", "qualitative", "case_study", "design_science", "mixed_methods", "desk_review"], "by": ["C"], "tier": "standard", "label": "Research design" },
        "paradigm": { "type": "enum", "enum": ["quantitative", "qualitative", "mixed", "formal"], "by": ["C"], "tier": "standard", "label": "Paradigm" },
        "domain": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "by": ["C"], "tier": "standard", "label": "Domain" },
        "theoretical_framework": { "type": "longtext", "by": ["C"], "tier": "deep", "label": "Theoretical framework" },
        "research_problem": { "type": "longtext", "by": ["C"], "tier": "core", "label": "Research problem" },
        "main_claim": { "type": "longtext", "by": ["C"], "tier": "core", "label": "Main claim" },
        "contributions": { "type": "object", "list": true, "props": { "text": "text", "kind": "text" }, "by": ["C"], "tier": "standard", "label": "Contributions", "help": "kind: novel, extension or application." },
        "approach": { "type": "longtext", "by": ["C"], "tier": "standard", "label": "Approach" },
        "evidence": { "type": "object", "props": { "type": "text", "source": "text", "n": "integer", "period": "text" }, "by": ["C"], "tier": "standard", "label": "Evidence" },
        "analysis_methods": { "type": "ref", "ref": "Method", "rel": "USES", "list": true, "by": ["C"], "tier": "standard", "label": "Analysis methods" },
        "key_findings": { "type": "object", "list": true, "props": { "text": "text", "location": "text" }, "by": ["C"], "tier": "standard", "label": "Key findings", "help": "Each finding needs a location (page or section)." },
        "limitations_stated": { "type": "text", "list": true, "by": ["C"], "tier": "standard", "label": "Stated limitations" },
        "limitations_observed": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "deep", "label": "Observed limitations" },
        "assumptions": { "type": "text", "list": true, "by": ["C"], "tier": "deep", "label": "Assumptions" },
        "threats_to_validity": { "type": "object", "props": { "internal": "text", "external": "text", "construct": "text", "conclusion": "text" }, "by": ["C"], "tier": "deep", "label": "Threats to validity" },
        "reproducibility": { "type": "object", "props": { "code_available": "boolean", "data_available": "boolean", "links": "text" }, "by": ["C"], "tier": "deep", "label": "Reproducibility" },
        "implications": { "type": "object", "props": { "theory": "text", "practice": "text" }, "by": ["C"], "tier": "deep", "label": "Implications" },
        "future_work": { "type": "text", "list": true, "by": ["C"], "tier": "deep", "label": "Future work" },
        "conflicts_funding": { "type": "longtext", "by": ["C"], "tier": "deep", "label": "Conflicts and funding" },
        "relevance": { "type": "integer", "min": 1, "max": 5, "by": ["Y"], "tier": "standard", "label": "Relevance" },
        "relevance_reason": { "type": "text", "by": ["Y"], "tier": "standard", "label": "Why relevant" },
        "reading_depth": { "type": "enum", "enum": ["skimmed", "read", "studied"], "by": ["Y"], "tier": "standard", "label": "Reading depth" },
        "rigor": { "type": "integer", "min": 1, "max": 5, "by": ["Y", "C"], "tier": "deep", "label": "Rigour" },
        "rigor_reason": { "type": "text", "by": ["Y", "C"], "tier": "deep", "label": "Rigour reason" },
        "novelty": { "type": "integer", "min": 1, "max": 5, "by": ["Y", "C"], "tier": "deep", "label": "Novelty" },
        "novelty_reason": { "type": "text", "by": ["Y", "C"], "tier": "deep", "label": "Novelty reason" },
        "confidence_in_findings": { "type": "enum", "enum": ["low", "medium", "high"], "by": ["Y"], "tier": "deep", "label": "Confidence in findings" }
      },
      "list_columns": ["title", "authors", "year", "contribution_type", "relevance"],
      "filters": ["item_type", "contribution_type", "research_design", "domain", "topics", "reading_depth"],
      "detail_groups": [
        { "label": "Bibliographic", "fields": ["authors", "year", "date", "venue", "item_type", "doi", "arxiv_id", "url", "abstract", "peer_review", "open_access", "citation_count", "citation_count_at", "language"] },
        { "label": "Classification", "fields": ["contribution_type", "research_design", "paradigm", "domain", "theoretical_framework"] },
        { "label": "Content", "fields": ["research_problem", "main_claim", "contributions", "approach", "evidence", "analysis_methods", "key_findings", "limitations_stated", "limitations_observed", "assumptions", "threats_to_validity", "reproducibility", "implications", "future_work", "conflicts_funding"] },
        { "label": "Appraisal", "fields": ["relevance", "relevance_reason", "reading_depth", "rigor", "rigor_reason", "novelty", "novelty_reason", "confidence_in_findings"] }
      ]
    },
    "method": {
      "label": "Method",
      "label_plural": "Methods",
      "color": "#f59e0b",
      "big": true,
      "folder": "methods",
      "collection": true,
      "managed": "db",
      "schema_version": 1,
      "key_prefix": "method:",
      "props": ["level", "domain"],
      "fields": {
        "aliases": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "core", "label": "Aliases" },
        "kind": { "type": "enum", "enum": ["technique", "algorithm", "protocol", "framework", "procedure", "metric", "tool"], "by": ["Y", "C"], "tier": "core", "label": "Kind" },
        "purpose": { "type": "longtext", "by": ["C", "Y"], "tier": "core", "label": "Purpose" },
        "domain": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Domain" },
        "level": { "type": "enum", "enum": ["foundational", "intermediate", "advanced"], "by": ["Y"], "tier": "standard", "label": "Level" },
        "maturity": { "type": "enum", "enum": ["experimental", "established", "standard"], "by": ["Y", "C"], "tier": "standard", "label": "Maturity" },
        "when_to_use": { "type": "longtext", "by": ["C", "Y"], "tier": "standard", "label": "When to use" },
        "when_not_to_use": { "type": "longtext", "by": ["C", "Y"], "tier": "standard", "label": "When not to use" },
        "inputs": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Inputs" },
        "outputs": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Outputs" },
        "procedure": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Procedure", "help": "Ordered steps." },
        "assumptions": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Assumptions" },
        "strengths": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Strengths" },
        "limitations": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Limitations", "help": "Including failure modes." },
        "cost_effort": { "type": "enum", "enum": ["low", "medium", "high"], "by": ["Y"], "tier": "deep", "label": "Cost and effort" },
        "cost_effort_note": { "type": "text", "by": ["Y"], "tier": "deep", "label": "Cost note" },
        "tools_implementations": { "type": "url", "list": true, "by": ["Y"], "tier": "deep", "label": "Tools and implementations" },
        "example": { "type": "longtext", "by": ["C", "Y"], "tier": "deep", "label": "Example" }
      },
      "list_columns": ["title", "kind", "level", "maturity", "domain"],
      "filters": ["kind", "level", "maturity", "domain", "topics"],
      "detail_groups": [
        { "label": "What it is", "fields": ["aliases", "kind", "purpose", "domain", "level", "maturity"] },
        { "label": "How to use it", "fields": ["when_to_use", "when_not_to_use", "inputs", "outputs", "procedure", "assumptions", "example"] },
        { "label": "Trade-offs", "fields": ["strengths", "limitations", "cost_effort", "cost_effort_note", "tools_implementations"] }
      ]
    },
    "use_case": {
      "label": "UseCase",
      "label_plural": "Use cases",
      "color": "#8b5cf6",
      "big": true,
      "folder": null,
      "collection": true,
      "managed": "db",
      "schema_version": 1,
      "key_prefix": "usecase:",
      "props": [],
      "public_props": ["key", "title", "summary"],
      "fields": {
        "goal": { "type": "longtext", "by": ["Y", "C"], "tier": "core", "label": "Goal" },
        "problem_context": { "type": "longtext", "by": ["Y", "C"], "tier": "core", "label": "Problem context" },
        "domain": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "list": true, "by": ["Y", "C"], "tier": "core", "label": "Domain" },
        "actors": { "type": "object", "list": true, "props": { "role": "text", "organisation_type": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Actors" },
        "preconditions": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "standard", "label": "Preconditions" },
        "scenario": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "standard", "label": "Scenario", "help": "Ordered steps." },
        "requirements": { "type": "object", "list": true, "props": { "kind": "text", "text": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Requirements", "help": "kind: functional, quality or constraint." },
        "success_criteria": { "type": "object", "list": true, "props": { "text": "text", "measure": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Success criteria" },
        "constraints": { "type": "object", "list": true, "props": { "kind": "text", "text": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Constraints", "help": "kind: legal, ethical, technical or economic." },
        "status": { "type": "enum", "enum": ["idea", "candidate", "validated", "in_use", "retired"], "by": ["Y"], "tier": "standard", "label": "Status" },
        "value": { "type": "longtext", "by": ["Y", "C"], "tier": "deep", "label": "Value" },
        "risks": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "deep", "label": "Risks" },
        "alternatives": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "deep", "label": "Alternatives" }
      },
      "list_columns": ["title", "status", "domain"],
      "filters": ["status", "domain", "topics"],
      "detail_groups": [
        { "label": "Problem", "fields": ["goal", "problem_context", "domain", "actors", "preconditions"] },
        { "label": "Scenario", "fields": ["scenario", "requirements", "success_criteria", "constraints"] },
        { "label": "Assessment", "fields": ["status", "value", "risks", "alternatives"] }
      ]
    },
    "case_study": {
      "label": "CaseStudy",
      "label_plural": "Case studies",
      "color": "#ef4444",
      "big": true,
      "folder": null,
      "collection": true,
      "managed": "db",
      "schema_version": 1,
      "key_prefix": "case:",
      "props": [],
      "public_props": ["key", "title", "summary"],
      "fields": {
        "case_type": { "type": "enum", "enum": ["deployment", "pilot", "failure", "comparative", "historical", "research"], "by": ["Y", "C"], "tier": "core", "label": "Case type" },
        "organisations": { "type": "ref", "ref": "Organisation", "rel": "INVOLVES", "list": true, "by": ["Y", "C"], "tier": "core", "label": "Organisations" },
        "sector": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "by": ["Y", "C"], "tier": "core", "label": "Sector" },
        "geography": { "type": "text", "by": ["Y", "C"], "tier": "core", "label": "Geography" },
        "sources": { "type": "object", "list": true, "props": { "url": "url", "note": "text" }, "by": ["Y"], "tier": "core", "label": "Sources", "help": "A URL or file link, with a note." },
        "period": { "type": "object", "props": { "from": "date", "to": "date" }, "by": ["Y", "C"], "tier": "standard", "label": "Period" },
        "context": { "type": "longtext", "by": ["Y", "C"], "tier": "standard", "label": "Context" },
        "trigger_problem": { "type": "longtext", "by": ["Y", "C"], "tier": "standard", "label": "Trigger problem" },
        "intervention": { "type": "longtext", "by": ["Y", "C"], "tier": "standard", "label": "Intervention" },
        "stakeholders": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "standard", "label": "Stakeholders" },
        "timeline": { "type": "object", "list": true, "props": { "date": "date", "event": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Timeline" },
        "outcomes": { "type": "object", "list": true, "props": { "measure": "text", "value": "text", "direction": "text", "expected": "boolean" }, "by": ["Y", "C"], "tier": "standard", "label": "Outcomes" },
        "lessons": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "standard", "label": "Lessons" },
        "evidence_quality": { "type": "object", "props": { "source_type": "text", "independence": "text" }, "by": ["Y", "C"], "tier": "standard", "label": "Evidence quality", "help": "source_type: primary_data, official_report, academic, journalism or anecdotal; independence: self_reported or independent." },
        "sensitivity": { "type": "enum", "enum": ["public", "internal", "confidential"], "by": ["Y"], "tier": "standard", "label": "Sensitivity" },
        "success_factors": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "deep", "label": "Success factors" },
        "barriers": { "type": "text", "list": true, "by": ["Y", "C"], "tier": "deep", "label": "Barriers" },
        "transferability": { "type": "longtext", "by": ["Y"], "tier": "deep", "label": "Transferability" }
      },
      "list_columns": ["title", "case_type", "organisations", "sector", "geography"],
      "filters": ["case_type", "sector", "sensitivity", "topics"],
      "detail_groups": [
        { "label": "Case", "fields": ["case_type", "organisations", "sector", "geography", "period", "sources", "sensitivity"] },
        { "label": "Story", "fields": ["context", "trigger_problem", "intervention", "stakeholders", "timeline"] },
        { "label": "Results", "fields": ["outcomes", "lessons", "evidence_quality", "success_factors", "barriers", "transferability"] }
      ]
    },
    "note": {
      "label": "Note",
      "label_plural": "Notes",
      "color": "#10b981",
      "big": true,
      "folder": "notes",
      "managed": "markdown",
      "schema_version": 1,
      "key_prefix": "note:",
      "props": ["note_kind"]
    },
    "project": {
      "label": "Project",
      "label_plural": "Projects",
      "color": "#ec4899",
      "big": true,
      "folder": "projects",
      "managed": "markdown",
      "schema_version": 1,
      "key_prefix": "project:",
      "props": ["repo", "period"]
    }
  },
  "entities": {
    "Person": { "match": "person", "color": "#94a3b8", "key_prefix": "person:", "public": true, "prune_orphans": true, "help": "Author; ORCID where available." },
    "Concept": { "match": "term", "color": "#06b6d4", "key_prefix": "concept:", "public": true, "prune_orphans": true },
    "Topic": { "match": "term", "color": "#0ea5e9", "key_prefix": "topic:", "public": true, "help": "Hierarchical through BROADER." },
    "Domain": { "match": "term", "color": "#14b8a6", "key_prefix": "domain:", "public": true, "help": "Short list maintained by the owner." },
    "Venue": { "match": "name", "color": "#a3a3a3", "key_prefix": "venue:", "public": true },
    "Organisation": { "match": "name", "color": "#78716c", "key_prefix": "org:", "public": false, "help": "Kept out of the public preview: case-study organisations can be sensitive." },
    "Dataset": { "match": "name", "color": "#84cc16", "key_prefix": "dataset:", "public": true }
  },
  "entity_matching": "How web/core/vocab.js matches names. term: plurals are singularised (topics, concepts, domains). name: proper names, no singularising. person: also reads 'Last, First'.",
  "entity_public_props": ["key", "name"],
  "relations": {
    "about": "ABOUT",
    "uses": "USES",
    "extends": "EXTENDS",
    "supports": "SUPPORTS",
    "contradicts": "CONTRADICTS",
    "critiques": "CRITIQUES",
    "annotates": "ANNOTATES",
    "inspired": "INSPIRED",
    "builds_on": "BUILDS_ON",
    "replicates": "REPLICATES",
    "introduces": "INTRODUCES",
    "addresses": "ADDRESSES",
    "instance_of": "INSTANCE_OF",
    "variant_of": "VARIANT_OF",
    "alternative_to": "ALTERNATIVE_TO",
    "requires": "REQUIRES"
  },
  "relation_types": {
    "CITES": { "from": ["Paper"], "to": ["Paper"], "help": "From OpenAlex." },
    "BUILDS_ON": { "from": ["Paper"], "to": ["Paper"], "interpretive": true },
    "CRITIQUES": { "from": ["Paper", "Note"], "to": ["Paper"], "interpretive": true },
    "REPLICATES": { "from": ["Paper"], "to": ["Paper"], "interpretive": true },
    "CONTRADICTS": { "from": ["Paper", "Note"], "to": ["Paper"], "interpretive": true },
    "SUPPORTS": { "from": ["Paper", "CaseStudy", "Note"], "to": ["Paper", "UseCase"], "interpretive": true },
    "EXTENDS": { "from": ["Paper", "Method", "Note", "Project"], "to": ["Paper", "Method", "Note", "Project"] },
    "INSPIRED": { "from": ["Paper", "Method", "Note", "Project"], "to": ["Paper", "Method", "Note", "Project"] },
    "ANNOTATES": { "from": ["Note"], "to": ["Paper", "Method", "UseCase", "CaseStudy", "Project"] },
    "INTRODUCES": { "from": ["Paper"], "to": ["Method"] },
    "USES": { "from": ["Paper", "CaseStudy", "Note", "Project", "Method"], "to": ["Method", "Dataset"] },
    "ADDRESSES": { "from": ["Method"], "to": ["UseCase"] },
    "INSTANCE_OF": { "from": ["CaseStudy"], "to": ["UseCase"] },
    "VARIANT_OF": { "from": ["Method"], "to": ["Method"] },
    "ALTERNATIVE_TO": { "from": ["Method"], "to": ["Method"] },
    "REQUIRES": { "from": ["Method"], "to": ["Method"] },
    "ABOUT": { "from": ["Paper", "Method", "UseCase", "CaseStudy", "Note", "Project"], "to": ["Topic", "Concept", "Domain"] },
    "AUTHORED_BY": { "from": ["Paper"], "to": ["Person"] },
    "PUBLISHED_IN": { "from": ["Paper"], "to": ["Venue"] },
    "INVOLVES": { "from": ["CaseStudy"], "to": ["Organisation"] },
    "BROADER": { "from": ["Topic"], "to": ["Topic"] }
  },
  "relation_props": ["evidence", "location", "confidence", "by", "at", "model", "status", "source"],
  "public_props": ["key", "title", "name", "year", "doi", "summary", "level", "domain", "authors", "author_lasts", "venue", "url"]
}
