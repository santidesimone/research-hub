        "conflicts_funding": { "type": "longtext", "by": ["C"], "tier": "deep", "label": "Conflicts and funding" },
        "sample": { "type": "object", "props": { "n": "integer", "respondent_profile": "text", "countries": "text", "industries": "text", "field_period": "text" }, "by": ["C"], "tier": "standard", "label": "Sample" },
        "methodology": { "type": "longtext", "by": ["C"], "tier": "standard", "label": "Methodology" },
        "claim_basis": { "type": "enum", "list": true, "enum": ["measured", "self_reported", "expectation", "modeled", "unspecified"], "by": ["C", "Y"], "tier": "standard", "label": "Claims rest on", "help": "What the headline numbers are: measured outcomes, self-reports, expectations or model output." },
        "key_findings": { "type": "object", "list": true, "props": { "text": "text", "location": "text" }, "by": ["C"], "tier": "standard", "label": "Key findings", "help": "Each finding needs a location (page or section)." },
        "recommendations": { "type": "object", "list": true, "props": { "text": "text", "location": "text" }, "by": ["C"], "tier": "standard", "label": "Recommendations", "help": "Each needs a location (page or section)." },
        "limitations_stated": { "type": "text", "list": true, "by": ["C"], "tier": "standard", "label": "Stated limitations" },
        "limitations_observed": { "type": "text", "list": true, "by": ["C", "Y"], "tier": "standard", "label": "Observed limitations" },
        "credibility_tier": { "type": "enum", "enum": ["usable_source", "use_with_caveats", "directional_only"], "by": ["C", "Y"], "tier": "core", "label": "Credibility" },
        "credibility_reason": { "type": "text", "by": ["C", "Y"], "tier": "core", "label": "Why that credibility" }
      },
      "list_columns": ["title", "publisher", "published_date", "credibility_tier"],
      "filters": ["publisher_type", "report_kind", "credibility_tier", "publisher", "domain", "topics"],
      "detail_groups": [
