    "TURNED_INTO": { "from": ["Thought"], "to": ["Paper", "Report", "Method", "UseCase", "CaseStudy", "Framework", "ResearchQuestion", "Hypothesis", "Ontology"], "help": "The item a thought became." },
    "INTRODUCES": { "from": ["Paper"], "to": ["Method"] },
    "USES": { "from": ["Paper", "CaseStudy", "Note", "Project", "Method"], "to": ["Method", "Dataset"] },
    "ADDRESSES": { "from": ["Method"], "to": ["UseCase"] },
