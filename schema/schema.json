    "REQUIRES": { "from": ["Method"], "to": ["Method"] },
    "ABOUT": { "from": ["Paper", "Report", "Method", "UseCase", "CaseStudy", "Note", "Thought", "Project", "Framework", "ResearchQuestion", "Hypothesis", "Ontology"], "to": ["Topic", "Concept", "Domain"] },
    "AUTHORED_BY": { "from": ["Paper", "Report"], "to": ["Person"] },
