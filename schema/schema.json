    "INVOLVES": { "from": ["CaseStudy"], "to": ["Organisation"] },
    "BROADER": { "from": ["Topic"], "to": ["Topic"] },
    "FRAMED_BY": { "from": ["Paper", "Report", "ResearchQuestion", "Project", "CaseStudy"], "to": ["Framework"] },
    "COMPETES_WITH": { "from": ["Framework"], "to": ["Framework"] },
    "SUB_QUESTION_OF": { "from": ["ResearchQuestion"], "to": ["ResearchQuestion"] },
    "ASKED_IN": { "from": ["ResearchQuestion"], "to": ["Paper"], "retired": "INFORMS", "help": "Retired: migration 014 made each one an INFORMS from the paper, and the question's text the paper's stated_question." },
    "ADDRESSED_BY": { "from": ["ResearchQuestion"], "to": ["Paper", "Method", "CaseStudy"], "retired": "INFORMS", "help": "Retired: migration 014 made each one an INFORMS from the source." },
    "INFORMS": { "from": ["Paper", "Report", "Method", "CaseStudy", "UseCase", "Framework", "Ontology", "Note"], "to": ["ResearchQuestion", "Hypothesis"], "props": { "role": { "type": "enum", "enum": ["background", "supports", "challenges"] } }, "help": "A source relevant to one of your questions or hypotheses. role: how (optional); evidence: why it matters; location: where. A paper that tested a hypothesis is TESTS." },
    "PART_OF": { "from": ["ResearchQuestion", "Ontology"], "to": ["Project", "Ontology"], "pairs": { "ResearchQuestion": ["Project"], "Ontology": ["Ontology"] } },
    "DERIVED_FROM": { "from": ["Hypothesis"], "to": ["Framework"] },
    "ANSWERS": { "from": ["Hypothesis"], "to": ["ResearchQuestion"] },
    "TESTS": { "from": ["Paper"], "to": ["Hypothesis"], "interpretive": true, "props": { "result": { "type": "enum", "enum": ["supported", "refuted", "mixed", "inconclusive"], "required": true } }, "help": "The paper's test of the hypothesis. The hypothesis status is derived from all TESTS results." },
    "ALIGNS_WITH": { "from": ["Ontology"], "to": ["Ontology"] },
    "USED_BY": { "from": ["Ontology"], "to": ["UseCase", "CaseStudy", "Paper", "Project"] },
    "DEFINED_IN": { "from": ["Concept"], "to": ["Ontology"], "props": { "external_iri": { "type": "text" } } },
    "PUBLISHED_BY": { "from": ["Ontology", "Report"], "to": ["Organisation"], "help": "The publisher of an ontology or standard (the addendum's publisher field), or of a report." }
  },
