        "domain": { "type": "ref", "ref": "Domain", "rel": "ABOUT", "by": ["C", "Y"], "tier": "standard", "label": "Domain" },
        "peer_review": { "type": "enum", "enum": ["peer_reviewed", "preprint", "grey"], "default": "grey", "by": ["C", "Y"], "tier": "standard", "label": "Peer review" },
