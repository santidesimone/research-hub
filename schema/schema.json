        "report_kind": { "type": "enum", "enum": ["survey_report", "market_analysis", "whitepaper", "case_collection", "policy_brief", "benchmark", "other"], "by": ["C", "Y"], "tier": "core", "label": "Kind of report" },
        "published_date": { "type": "date", "by": ["C", "Y"], "tier": "standard", "label": "Published", "help": "YYYY, YYYY-MM or YYYY-MM-DD." },
